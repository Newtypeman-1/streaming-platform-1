# PostgreSQL (docker-compose 와 서버가 함께 사용)
POSTGRES_DB=streaming
POSTGRES_USER=streaming
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# 서버
DATABASE_URL=postgres://streaming:change-me@localhost:5432/streaming
SERVER_PORT=8000
# 업로드한 영상이 저장될 디렉터리 (상대경로는 실행 위치 기준)
VIDEO_STORAGE_DIR=storage/videos

# 라이브 (2단계)
# 휴대폰이 접속할 이 컴퓨터의 LAN IP. macOS: ipconfig getifaddr en0
# docker-compose 가 MediaMTX(영상 경로)와 HTTPS 프록시(Caddy)에 넘겨준다
PUBLIC_HOST=192.168.0.10
# API 서버가 MediaMTX 에 접속할 주소 (WHIP/WHEP 신호, Control API)
MEDIAMTX_URL=http://localhost:8889
MEDIAMTX_API_URL=http://localhost:9997
