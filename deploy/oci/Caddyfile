# 도메인으로 들어온 요청을 HTTPS 로 받는다. 인증서는 Caddy 가 Let's Encrypt 에서 자동으로 받고 갱신한다
# (DNS A 레코드가 이 VM 을 가리키고, 80·443 이 열려 있어야 한다). HTTP 로 들어오면 HTTPS 로 넘긴다.
{$NADRI_DOMAIN} {
	encode zstd gzip

	# API. Caddy 가 X-Forwarded-Proto: https 를 붙여 주므로 서버가 세션 쿠키에 Secure 를 붙인다.
	handle /api/* {
		reverse_proxy server:8000
	}

	# 데스크톱 클라이언트 다운로드 페이지(/download/)와 설치 파일(/downloads/...)
	@download path /download /download/* /downloads/*
	handle @download {
		root * /srv/site
		file_server
	}

	# 웹 앱. 주소창에서 바로 연 하위 경로(/broadcasts/1 등)도 앱이 그리도록 index.html 로 보낸다.
	handle {
		root * /srv/site/web
		try_files {path} /index.html
		file_server
	}
}
