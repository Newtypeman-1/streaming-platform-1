# VM 의 /opt/nadri/.env 로 복사해 채운다. 실제 값은 저장소에 올리지 않는다.
#   scp deploy/oci/.env.example nadri:/opt/nadri/.env  →  ssh nadri 'chmod 600 /opt/nadri/.env && nano /opt/nadri/.env'

# 서비스 도메인 (DNS A 레코드가 PUBLIC_IP 를 가리켜야 인증서가 발급된다)
NADRI_DOMAIN=nadri.live
# VM 공인 IP (WebRTC 영상이 이 주소로 오간다)
PUBLIC_IP=203.0.113.10

# PostgreSQL. 비밀번호는 URL 에 들어가므로 영문·숫자만 쓴다: openssl rand -hex 24
POSTGRES_DB=nadri
POSTGRES_USER=nadri
POSTGRES_PASSWORD=change-me

# 후원 결제 - 토스페이먼츠 테스트 키(test_gck_, test_gsk_). 비우면 후원만 동작하지 않는다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# deploy.sh 가 올린 서버 이미지 태그 (보통 건드리지 않는다)
SERVER_TAG=latest
